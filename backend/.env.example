# KIS API Credentials
KIS_APP_KEY="YOUR_APP_KEY"
KIS_APP_SECRET="YOUR_APP_SECRET"
KIS_ACCOUNT_NO="YOUR_ACCOUNT_NUMBER"

# KIS API URL
KIS_BASE_URL="https://openapivts.koreainvestment.com:29443" # For mock trading
# KIS_BASE_URL="https://openapi.koreainvestment.com:9443" # For real trading

# PostgreSQL Database
DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5432/kis_invest"

# Open DART API (재무 데이터 수집용)
# https://opendart.fss.or.kr/ 에서 발급
DART_API_KEY="YOUR_DART_API_KEY"

# JWT Authentication
JWT_SECRET_KEY="your_super_secret_key_please_change_this_in_production"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Key Encryption (AES) - 반드시 안전한 랜덤 값으로 교체하세요
# 32-byte (256-bit) Fernet key - python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 로 생성
ENCRYPTION_KEY="YOUR_FERNET_ENCRYPTION_KEY"
